{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "display": {
    "separator": "  "
  },

  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii/1.txt"
  },


  "modules": [
    {
      "type": "custom",
      "format": "\u001b[90m┌───────────────────────────────────────────────────────────┐\u001b[0m"
    },

    { "type": "os",       "key": "\u001b[90m\u001b[0m" },
    { "type": "host",     "key": "\u001b[90m\u001b[0m" },
    { "type": "packages", "key": "\u001b[90m󰏖\u001b[0m" },
    { "type": "wm",       "key": "\u001b[90m\u001b[0m" },
    { "type": "terminal", "key": "\u001b[90m\u001b[0m" },
    { "type": "uptime",   "key": "\u001b[90m󰅐\u001b[0m" },

    {
      "type": "custom",
      "format": "\u001b[90m└───────────────────────────────────────────────────────────┘\u001b[0m"
    },

  ]
}
